{
  "name": "site-cuder",
  "compatibility_date": "2026-08-04",
  "main": "./contact-email-worker.js",
  "build": {
    "command": "bun run build",
    "watch_dir": [
      "src",
      "public",
      "astro.config.mjs",
      "tailwind.config.mjs",
      "tsconfig.json",
    ],
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/contact"],
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "info@sencila-cuder.com",
    },
  ],
}
