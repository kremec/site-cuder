{
  "name": "site-cuder",
  "compatibility_date": "2026-08-04",
  "main": "./contact-email-worker.js",
  "build": {
    "command": "bun run build",
    "watch_dir": [
      "src",
      "public",
      "astro.config.mjs",
      "tailwind.config.mjs",
      "tsconfig.json",
    ],
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/contact"],
  },
  // Preview pages do not use the production email or queue bindings.
  "previews": {},
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "info@sencila-cuder.com",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "CONTACT_INQUIRIES",
        "queue": "site-cuder-contact-emails",
      },
    ],
    "consumers": [
      {
        "queue": "site-cuder-contact-emails",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "site-cuder-contact-emails-failed",
      },
    ],
  },
}
