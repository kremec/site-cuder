---
import { SITE_TITLE } from "@/const/names";

const year = new Date().getFullYear();
---

<footer
  class="h-16 md:h-18 border-t border-ink/20 px-5 md:px-12 xl:px-16"
>
  <div class="mx-auto flex h-full max-w-7xl items-center">
    <small class="text-sm">{SITE_TITLE} s.p. © {year}</small>
  </div>
</footer>
