---
import { SITE_TITLE } from "@/const/names";

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/20 px-5 md:px-12 xl:px-16">
  <div
    class="mx-auto flex min-h-16 md:min-h-18 max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3"
  >
    <small class="text-sm">{SITE_TITLE} s.p. © {year}</small>
    <a class="py-2 text-sm underline underline-offset-4" href="/privacy/">
      Politika zasebnosti
    </a>
  </div>
  <slot />
</footer>
