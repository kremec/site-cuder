---
import {
  MapPin,
  MessageCircleQuestionMark,
  Phone,
  UserRound,
} from "@lucide/astro";
import {
  CONTACT_ADDRESS,
  CONTACT_EMAIL,
  CONTACT_EMAIL_LINK,
  CONTACT_PHONE,
  CONTACT_PHONE_LINK,
} from "@/const/names";
---

<section class="px-5 md:px-12 xl:px-16 py-20 md:py-24" id="kontakt">
  <div class="mx-auto grid lg:grid-cols-2 max-w-7xl gap-12 lg:gap-20">
    <div class="flex flex-col">
      <h2
        class="font-display text-5xl xl:text-6xl font-black leading-none tracking-tight"
      >
        POTREBUJETE SERVIS ALI MONTAŽO SENČIL?
      </h2>
      <p class="mt-6 max-w-xl leading-relaxed">
        Kontaktirajte nas in dogovorili se bomo za ogled ter rešitev, ki najbolj
        ustreza vašemu prostoru.
      </p>

      <dl class="mt-12 lg:mt-auto lg:pt-12 max-w-xl">
        <div class="border-ink/30 flex gap-8 border-b py-4">
          <dt class="w-28 shrink-0">TELEFON</dt>
          <dd class="font-bold">
            <a
              class="underline underline-offset-4"
              href={CONTACT_PHONE_LINK}>{CONTACT_PHONE}</a
            >
          </dd>
        </div>
        <div class="border-ink/30 flex gap-8 border-b py-4">
          <dt class="w-28 shrink-0">E-POŠTA</dt>
          <dd>
            <a
              class="underline underline-offset-4"
              href={CONTACT_EMAIL_LINK}>{CONTACT_EMAIL}</a
            >
          </dd>
        </div>
        <div class="border-ink/30 flex gap-8 border-b py-4">
          <dt class="w-28 shrink-0">NASLOV</dt>
          <dd><address class="not-italic">{CONTACT_ADDRESS}</address></dd>
        </div>
        <div class="border-ink/30 flex gap-8 border-b py-4">
          <dt class="w-28 shrink-0">DOSEGLJIVOST</dt>
          <dd class="grid flex-1 grid-cols-2 gap-x-5">
            <span>Pon. - pet.</span><span>7:00 - 19:00</span>
            <span>Sob.</span><span>8:00 - 12:00</span>
          </dd>
        </div>
      </dl>
    </div>

    <form
      class="border-ink grid border-t border-l"
      aria-label="Kontaktni obrazec"
      action="/api/contact"
      method="post"
      data-contact-form
    >
      <label
        class="border-ink flex items-center gap-4 border-r border-b p-5 focus-within:bg-white/25"
      >
        <UserRound class="size-5 shrink-0" />
        <span class="sr-only">Ime in priimek</span>
        <input
          type="text"
          class="placeholder:text-ink/65 min-w-0 flex-1 text-sm font-bold focus:outline-none!"
          name="name"
          autocomplete="name"
          placeholder="IME IN PRIIMEK"
          maxlength="100"
          required
        />
      </label>
      <label
        class="border-ink flex items-center gap-4 border-r border-b p-5 focus-within:bg-white/25"
      >
        <Phone class="size-5 shrink-0" />
        <span class="sr-only">Telefon ali e-pošta</span>
        <input
          type="text"
          class="placeholder:text-ink/65 min-w-0 flex-1 text-sm font-bold focus:outline-none!"
          name="contact"
          autocomplete="on"
          placeholder="TELEFON ALI E-POŠTA"
          maxlength="200"
          required
        />
      </label>
      <label
        class="border-ink flex items-center gap-4 border-r border-b p-5 focus-within:bg-white/25"
      >
        <MapPin class="size-5 shrink-0" />
        <span class="sr-only">Lokacija objekta</span>
        <input
          type="text"
          class="placeholder:text-ink/65 min-w-0 flex-1 text-sm font-bold focus:outline-none!"
          name="location"
          placeholder="LOKACIJA OBJEKTA"
          maxlength="200"
        />
      </label>
      <label
        class="border-ink flex items-start gap-4 border-r border-b p-5 focus-within:bg-white/25"
      >
        <MessageCircleQuestionMark class="size-5 shrink-0" />
        <span class="sr-only">Kaj potrebujete?</span>
        <textarea
          class="placeholder:text-ink/65 min-h-28 min-w-0 flex-1 text-sm font-bold focus:outline-none!"
          name="message"
          placeholder="OPIŠITE TEŽAVO ALI ŽELENO SENČILO"
          maxlength="4000"
          required></textarea>
      </label>
      <button
        class="min-h-16 cursor-pointer bg-orange text-xl xl:text-2xl font-black text-white focus-visible:outline-ink disabled:cursor-not-allowed disabled:opacity-60"
        type="submit"
        disabled
      >
        POŠLJI POVPRAŠEVANJE
      </button>
    </form>
  </div>
</section>

<script>
  import { showToast } from "./toast";

  declare const posthog: { capture: (event: string) => void };

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]")!;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  button.disabled = false;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (button.disabled) return;

    button.disabled = true;
    button.textContent = "POŠILJANJE ...";
    form.setAttribute("aria-busy", "true");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (response.status !== 202) throw new Error("Send failed");

      form.reset();
      showToast({
        variant: "success",
        title: "Povpraševanje prejeto",
        description: "Hvala za vaše sporočilo.",
      });
    } catch {
      showToast({
        variant: "error",
        title: "Pošiljanje ni uspelo",
        description: "Poskusite znova ali nas pokličite.",
      });
      return;
    } finally {
      button.disabled = false;
      button.textContent = "POŠLJI POVPRAŠEVANJE";
      form.removeAttribute("aria-busy");
    }

    if (typeof posthog !== "undefined") posthog.capture("inquiry_submitted");
  });
</script>
