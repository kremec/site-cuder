---
import { Picture } from "astro:assets";
import { products } from "@/const/products";
---

<section class="bg-orange px-5 md:px-12 xl:px-16 py-20 md:py-24" id="zakaj">
  <div class="mx-auto max-w-7xl">
    <header class="mb-14 grid lg:grid-cols-2 items-end gap-12 lg:gap-20">
      <h2
        class="font-display text-5xl xl:text-6xl font-black leading-none tracking-tight text-charcoal"
      >
        POPRAVIMO.<br />VGRADIMO.
      </h2>
      <p class="max-w-2xl leading-relaxed text-charcoal">
        Senčila servisiramo, popravimo in nastavimo, dotrajane ali poškodovane
        dele pa zamenjamo. Nova senčila natančno vgradimo in vam svetujemo pri
        izbiri rešitve za vaš prostor.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {
        products.map(({ slug, name, copy, image, alt }) => (
          <a
            href={`/${slug}/`}
            class="relative flex min-h-96 lg:min-h-108 min-w-0 flex-col justify-end overflow-hidden p-6 xl:p-8 group"
          >
            <Picture
              class="absolute inset-0 size-full object-cover brightness-85 saturate-90 transition-transform duration-500 group-hover:scale-105 group-focus-visible:scale-105"
              src={image}
              alt={alt}
              loading="lazy"
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
              formats={["avif"]}
              fallbackFormat="webp"
              quality={45}
            />
            <div class="absolute inset-0 bg-linear-to-t from-black via-black/50 to-transparent" />
            <h3 class="z-10 mb-4 text-2xl lg:text-xl xl:text-2xl font-black leading-none text-white uppercase">
              {name}
            </h3>
            <p class="z-10 leading-relaxed text-white">{copy}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
